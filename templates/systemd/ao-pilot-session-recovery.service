[Unit]
Description=AO Pilot immutable session-recovery
After={{RUNTIME_UNIT}}
Wants={{RUNTIME_UNIT}}

[Service]
Type=simple
WorkingDirectory={{STATE_ROOT}}
EnvironmentFile={{ENV_FILE}}
ExecStart="{{NODE}}" "{{CURRENT}}/scripts/ao-release-entry.js" session-recovery
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
