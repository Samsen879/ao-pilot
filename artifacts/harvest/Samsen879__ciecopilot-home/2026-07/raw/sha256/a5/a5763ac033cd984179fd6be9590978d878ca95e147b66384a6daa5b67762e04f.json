ion of Gemini Code Assist on GitHub](https://developers.google.com/gemini-code-assist/docs/review-repo-code) is being sunset. Starting **June 18, 2026**, new organization installations will be blocked, and all code review activity will officially cease on **July 17, 2026**.\n> For more details on the timeline and next steps, please review the [Help Documentation](https://developers.google.com/gemini-code-assist/docs/deprecations/consumer-code-review).","state":"COMMENTED","html_url":"https://github.com/Samsen879/ciecopilot-home/pull/1518#pullrequestreview-4663405336","pull_request_url":"https://api.github.com/repos/Samsen879/ciecopilot-home/pulls/1518","author_association":"NONE","_links":{"html":{"href":"https://github.com/Samsen879/ciecopilot-home/pull/1518#pullrequestreview-4663405336"},"pull_request":{"href":"https://api.github.com/repos/Samsen879/ciecopilot-home/pulls/1518"}},"submitted_at":"2026-07-09T13:32:27Z","commit_id":"118c10f39e7d5f8d0074979008cbe72b33ae28f2"},{"id":4663740888,"node_id":"PRR_kwDOO5D6p88AAAABFfsJ2A","user":{"login":"Samsen879","id":172257175,"node_id":"U_kgDOCkRvlw","avatar_url":"https://avatars.githubusercontent.com/u/172257175?v=4","gravatar_id":"","url":"https://api.github.com/users/Samsen879","html_url":"https://github.com/Samsen879","followers_url":"https://api.github.com/users/Samsen879/followers","following_url":"https://api.github.com/users/Samsen879/following{/other_user}","gists_url":"https://api.github.com/users/Samsen879/gists{/gist_id}","starred_url":"https://api.github.com/users/Samsen879/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Samsen879/subscriptions","organizations_url":"https://api.github.com/users/Samsen879/orgs","repos_url":"https://api.github.com/users/Samsen879/repos","events_url":"https://api.github.com/users/Samsen879/events{/privacy}","received_events_url":"https://api.github.com/users/Samsen879/received_events","type":"User","user_view_type":"public","site_admin":false},"body":""