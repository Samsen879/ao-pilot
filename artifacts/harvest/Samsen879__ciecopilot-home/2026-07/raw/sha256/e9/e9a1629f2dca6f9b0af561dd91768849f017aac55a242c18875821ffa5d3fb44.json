[{"sha":"793688f9b0cbaef1435342ce2935096f1050772b","node_id":"C_kwDOO5D6p9oAKDc5MzY4OGY5YjBjYmFlZjE0MzUzNDJjZTI5MzUwOTZmMTA1MDc3MmI","commit":{"author":{"name":"codex-cli","email":"guoqiyang25@gmail.com","date":"2026-07-07T19:04:33Z"},"committer":{"name":"codex-cli","email":"guoqiyang25@gmail.com","date":"2026-07-07T19:04:33Z"},"message":"feat(method-map): map structured mark-point and worked-solution posture (#1433)\n\nAdd a checked-in structured review posture mapping artifact and validator for\npost-attempt review payloads.\n\nMaps existing MS source/span/raw-item/candidate-link signals into structured\nmark-point posture (accepted/provisional/candidate_only/missing/blocked) and\nworked-solution posture (accepted/provisional/fallback_explanation/missing/\nblocked), keeping structured/native display primary even when source screenshots\nexist.\n\nScoring stays fully separated from structured availability via scoring_posture,\npoint_judgement_allowed, authoritative_score_allowed and an optional\nscoring_authority_ref. Candidate/provenance evidence never becomes accepted\nscoring truth; provisional/candidate content requires downgraded wording and\ncannot support confident final scoring. Accepted structured marks support\nself-assessment/diagnostics but never authorize scoring without a released\nscoring authority.\n\nThis mapping artifact ships no released scoring authority, so every checked-in\ncase keeps authoritative_score_allowed and point_judgement_allowed false\n(authoritative_score_allowed_count = 0) and makes no official scoring or Smart\nMark readiness claim. The resolver still opens deterministic scoring only for a\ngenuine released authority, proven by a unit test and never asserted by the\nartifact. Rows without structured MS still emit fallback review payloads.\n\nDepends on #1431 and #1432. Parent #1427.\n\nCo-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>","tree":{"sha":"81180a21ec99536ac5fca14feedb6efd492b6099","url":"https://api.github.com/repos/Samsen879/ciecopilot-home/git/trees/81180a21ec99536ac5fca14feedb6efd492b6099"},"url":"https://api.github.com/repos/Samsen879/ciecopilot-home/git/commits/793688f9b0cbaef1435342ce2935096f1050772b","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Samsen879/ciecopilot-home/commits/793688f9b0cbaef1435342ce2935096f1050772b","html_url":"https://github.com/Samsen879/ciecopilot-home/commit/793688f9b0cbaef1435342ce2935096f1050772b","comments_url":"https://api.github.com/repos/Samsen879/ciecopilot-home/commits/793688f9b0cbaef1435342ce2935096f1050772b/comments","author":{"login":"Samsen879","id":172257175,"node_id":"U_kgDOCkRvlw","avatar_url":"https://avatars.githubusercontent.com/u/172257175?v=4","gravatar_id":"","url":"https://api.github.com/users/Samsen879","html_url":"https://github.com/Samsen879","followers_url":"https://api.github.com/users/Samsen879/followers","following_url":"https://api.github.com/users/Samsen879/following{/other_user}","gists_url":"https://api.github.com/users/Samsen879/gists{/gist_id}","starred_url":"https://api.github.com/users/Samsen879/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Samsen879/subscriptions","organizations_url":"https://api.github.com/users/Samsen879/orgs","repos_url":"https://api.github.com/users/Samsen879/repos","events_url":"https://api.github.com/users/Samsen879/events{/privacy}","received_events_url":"https://api.github.com/users/Samsen879/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Samsen879","id":172257175,"node_id":"U_kgDOCkRvlw","avatar_url":"https://avatars.githubusercontent.com/u/172257175?v=4","gravatar_id":"","url":"https://api.github.com/users/Samsen879","html_url":"https://github.com/Samsen879","followers_url":"https://api.github.com/users/Samsen879/followers","following_url":"https://api.github.com/users/Samsen879/following