{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ao-pilot.dev/ao.child-completion-input-manifest.v1alpha1.schema.json",
  "title": "AO child Completion Record canonical input manifest v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "child_task_id", "inputs"],
  "properties": {
    "schema_version": { "const": "ao.child-completion-input-manifest.v1alpha1" },
    "child_task_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "schema_version", "uri", "content_sha256"],
        "properties": {
          "input_id": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
          "schema_version": { "type": "string", "minLength": 1, "pattern": "^[^\\s]+$" },
          "uri": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\s]+$"
          },
          "content_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
