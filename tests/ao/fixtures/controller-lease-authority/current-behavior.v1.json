{
  "schema_version": "ao.controller-lease-current-behavior-fixtures.v1",
  "fixture_version": "2026-08-09.1",
  "cases": [
    {
      "id": "dedicated-success-overlays-shadow",
      "class": "success",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "records", "leases": ["canonical-active"] },
      "expected": { "outcome": "snapshot", "lease_ids": ["canonical-active"] }
    },
    {
      "id": "empty-dedicated-clears-shadow",
      "class": "success",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "records", "leases": [] },
      "expected": { "outcome": "snapshot", "lease_ids": [] }
    },
    {
      "id": "invalid-dedicated-record-fails",
      "class": "failure",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "invalid-record" },
      "expected": { "outcome": "throw", "message": "Invalid lease_id" }
    },
    {
      "id": "missing-dedicated-fails-closed",
      "class": "missing",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "missing" },
      "expected": { "outcome": "throw", "message": "Missing canonical controller lease authority" }
    },
    {
      "id": "missing-state-fails-closed",
      "class": "missing",
      "state_shadow": "shadow-active",
      "state_file": "missing",
      "dedicated": { "kind": "records", "leases": ["canonical-active"] },
      "expected": { "outcome": "throw", "message": "Incomplete control-plane state evidence" }
    },
    {
      "id": "non-array-dedicated-fails-closed",
      "class": "malformed",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "json-object" },
      "expected": { "outcome": "throw", "message": "Unsupported canonical controller lease authority version" }
    },
    {
      "id": "invalid-json-dedicated-fails",
      "class": "malformed",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "invalid-json" },
      "expected": { "outcome": "throw", "error_name": "SyntaxError" }
    },
    {
      "id": "canonical-wins-mixed-version",
      "class": "mixed-version",
      "state_shadow": "legacy-shadow",
      "state_shadow_format": "legacy-v1",
      "schema_current_version": 1,
      "dedicated": { "kind": "records", "leases": ["canonical-active"] },
      "expected": { "outcome": "snapshot", "lease_ids": ["canonical-active"], "schema_current_version": 11 }
    },
    {
      "id": "snapshot-replay-is-byte-stable",
      "class": "replay",
      "state_shadow": "shadow-active",
      "dedicated": { "kind": "records", "leases": ["canonical-active"] },
      "expected": { "outcome": "replay", "lease_ids": ["canonical-active"] }
    }
  ]
}
